{
  "name": "ricks-clips-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Ricks Clips animation engine (Remotion + three.js). Phase 5A foundation.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio remotion/index.ts",
    "still": "node --experimental-strip-types --no-warnings remotion/scripts/still.ts",
    "test:beats": "node --experimental-strip-types --no-warnings src/contracts/beats.test.ts",
    "test:time": "node --experimental-strip-types --no-warnings src/contracts/time.test.ts",
    "test:narration": "node --experimental-strip-types --no-warnings src/contracts/narration.test.ts",
    "test": "npm run typecheck && npm run test:time && npm run test:beats && npm run test:narration",
    "synth-narration": "node --experimental-strip-types --no-warnings remotion/scripts/make-synthetic-narration.ts",
    "render-narration": "node --experimental-strip-types --no-warnings remotion/scripts/render-narration.ts",
    "render-narration:synthetic": "npm run synth-narration && npm run render-narration -- --descriptor assets/private/audio/TEST6S/synthetic/narration.descriptor.json"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.547",
    "@remotion/cli": "4.0.547",
    "@remotion/renderer": "4.0.547",
    "@remotion/three": "4.0.547",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.547",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
