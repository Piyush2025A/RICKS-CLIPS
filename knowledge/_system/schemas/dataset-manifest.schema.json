{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RC30 frozen dataset manifest (core, v2 - D028)",
  "type": "object",
  "required": [
    "dataset_id",
    "manifest_version",
    "channel_url",
    "selection_rule",
    "order_basis",
    "frozen_at",
    "frozen_by",
    "acquisition_method",
    "videos"
  ],
  "properties": {
    "dataset_id": {
      "const": "RC30"
    },
    "channel_url": {
      "type": "string"
    },
    "selection_rule": {
      "type": "string",
      "description": "30 most recently published Shorts by publication date at freeze time"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "frozen_by": {
      "type": "string"
    },
    "acquisition_method": {
      "type": "string",
      "description": "user-approved authorised method; recorded, never a download URL with tokens"
    },
    "videos": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "key",
          "local_filename",
          "title",
          "availability",
          "identity_status",
          "media"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^RC30-(0[1-9]|[12][0-9]|30)$"
          },
          "video_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "duration_s": {
            "type": "number"
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "availability": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "metadata_source": {
            "type": "string"
          },
          "media": {
            "type": "object",
            "description": "filled after authorised acquisition (private copy, not committed)",
            "properties": {
              "sha256": {
                "type": "string"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "avg_frame_rate": {
                "type": "string"
              },
              "r_frame_rate": {
                "type": "string"
              },
              "nb_frames": {
                "type": "integer"
              },
              "video_codec": {
                "type": "string"
              },
              "audio_codec": {
                "type": "string"
              },
              "audio_sample_rate": {
                "type": "integer"
              }
            },
            "required": [
              "sha256",
              "width",
              "height",
              "r_frame_rate",
              "avg_frame_rate",
              "nb_frames"
            ]
          },
          "local_filename": {
            "type": "string"
          },
          "identity_status": {
            "enum": [
              "deferred",
              "verified"
            ]
          }
        }
      }
    },
    "manifest_version": {
      "const": 2
    },
    "order_basis": {
      "type": "string",
      "description": "how newest-to-oldest order was established (user attestation and/or verified publication dates)"
    },
    "identity_file": {
      "type": "string",
      "description": "deferred metadata (video IDs, publication dates, URLs) lives here; filling it never changes this core file"
    }
  }
}
