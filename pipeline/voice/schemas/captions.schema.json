{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "captions.schema.json",
  "title": "Caption schedule at one frame rate (captions_<fps>.json)",
  "type": "object",
  "required": ["schema_version", "fps", "duration_s", "total_frames", "lead_s", "captions"],
  "properties": {
    "schema_version": {"type": "string"},
    "fps": {"type": "integer", "minimum": 1, "description": "30 (final) or 24 (development)"},
    "duration_s": {"type": "number", "minimum": 0},
    "total_frames": {"type": "integer", "minimum": 0, "description": "round(duration_s * fps)"},
    "lead_s": {"type": "number", "minimum": 0, "description": "caption lead before onset, default 0.140"},
    "lead_frames": {"type": "integer"}, "hold_frames": {"type": "integer"},
    "merge_function_words": {"type": "boolean"},
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "token", "show_at", "hide_at", "frame_in", "frame_out", "sentence_final"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "token": {"type": "string"},
          "word_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "show_at": {"type": "number", "minimum": 0},
          "hide_at": {"type": "number", "minimum": 0},
          "frame_in": {"type": "integer", "minimum": 0, "description": "first frame shown (inclusive)"},
          "frame_out": {"type": "integer", "minimum": 1, "description": "first frame NOT shown (exclusive)"},
          "sentence_final": {"type": "boolean"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
