{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "words.schema.json",
  "title": "Canonical word timeline (productions/<id>/voice/words.json)",
  "type": "object",
  "required": ["schema_version", "source", "duration_s", "words"],
  "properties": {
    "schema_version": {"type": "string"},
    "source": {"enum": ["api_alignment", "scribe", "forced"], "description": "method that produced the timings"},
    "duration_s": {"type": ["number", "null"], "minimum": 0, "description": "audio duration in seconds (ffprobe)"},
    "text": {"type": ["string", "null"], "description": "text exactly as submitted to TTS (char spans index into it)"},
    "audio_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "word", "t_on", "t_off", "char_start", "char_end", "source", "confidence"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "word": {"type": "string", "description": "display form incl. attached punctuation"},
          "t_on": {"type": "number", "minimum": 0, "description": "voice onset, seconds from audio start"},
          "t_off": {"type": "number", "minimum": 0},
          "char_start": {"type": "integer", "minimum": -1, "description": "-1 = unknown (Scribe without script)"},
          "char_end": {"type": "integer", "minimum": -1, "description": "exclusive"},
          "source": {"enum": ["api_alignment", "scribe", "forced"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1, "description": "1.0 for API alignment; exp(logprob) for Scribe; 0 interpolated"},
          "flags": {"type": "array", "items": {"enum": ["substituted", "interpolated", "repaired", "text_differs_from_alignment"]}}
        }
      }
    },
    "validation_issues": {"type": "array", "items": {"type": "string"}},
    "alignment_report": {"type": "object"}
  }
}
