{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-provenance.schema.json",
  "title": "Asset provenance sidecar (A24 intake v1)",
  "type": "object",
  "required": ["schema_version", "asset_id", "kind", "request_id", "file", "generation", "protection", "technical", "chain_of_custody"],
  "properties": {
    "schema_version": {"const": 1},
    "script_version": {"type": "string"},
    "asset_id": {"type": "string"},
    "kind": {"enum": ["character", "expression", "parts", "prop", "texture", "environment", "audio", "other"]},
    "request_id": {"type": "string"},
    "file": {
      "type": "object",
      "required": ["stored_name", "original_basename", "size_bytes", "sha256"],
      "properties": {
        "stored_name": {"type": "string"}, "original_basename": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "provider": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]},
        "prompt": {"type": ["string", "null"]}, "prompt_file": {"type": ["string", "null"]},
        "settings": {"type": ["object", "null"]}, "credits_consumed": {"type": ["number", "null"]}
      }
    },
    "protection": {
      "type": "object",
      "required": ["c2pa_chunk_present", "preserved_unmodified"],
      "properties": {
        "visible_watermark": {"enum": ["yes", "no", "unknown"]},
        "c2pa_chunk_present": {"type": "boolean"},
        "synthid_claimed_by_provider": {"enum": ["yes", "no", "unknown"]},
        "preserved_unmodified": {"type": "boolean"}
      }
    },
    "technical": {
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": {"type": "string"}, "width": {"type": "integer"}, "height": {"type": "integer"},
        "mode": {"type": "string"}, "bit_depth": {"type": "integer"}, "has_alpha_channel": {"type": "boolean"},
        "alpha": {"type": ["object", "null"]}, "png_chunks": {"type": "array"},
        "c2pa_chunks": {"type": "array"}, "text_chunks": {"type": "array"},
        "exif_present": {"type": "boolean"}, "xmp_present": {"type": "boolean"}
      }
    },
    "licence_terms_note": {"type": ["string", "null"]},
    "chain_of_custody": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["event", "utc", "actor"],
        "properties": {
          "event": {"type": "string", "description": "generated | downloaded | intaken | transferred_via_drive | verified | other"},
          "utc": {"type": "string"}, "actor": {"type": "string"}, "detail": {"type": "string"}
        }
      }
    }
  }
}
